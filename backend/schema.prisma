generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
  enable_experimental_decimal = true
  output               = "app/prisma_client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id                     Int                   @id @default(autoincrement())
  phone_number           String                @unique @db.VarChar(20)
  name                   String?               @db.VarChar(100)
  created_at             DateTime              @default(now()) @db.Timestamptz(6)
  updated_at             DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  preferences            CustomerPreferences?
  orders                 Order[]
  conversation_summaries ConversationSummary[]

  @@map("customers")
}

model CustomerPreferences {
  id                  Int      @id @default(autoincrement())
  customer_id         Int      @unique
  customer            Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  spice_level         String?  @db.VarChar(20)
  allergies           String?  @db.Text
  dietary_preferences String?  @db.Text
  favorite_dishes     String?  @db.Text
  disliked_dishes     String?  @db.Text
  updated_at          DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("customer_preferences")
}

model MenuItem {
  id            Int         @id @default(autoincrement())
  name          String      @db.VarChar(150)
  category      String      @db.VarChar(80)
  cuisine       String      @default("indian") @db.VarChar(50)
  description   String?     @db.Text
  price         Decimal     @db.Decimal(10, 2)
  is_vegetarian Boolean     @default(false)
  is_vegan      Boolean     @default(false)
  spice_level   String?     @db.VarChar(20)
  allergens     String?     @db.Text
  is_available  Boolean     @default(true)
  meal_times    String?     @db.VarChar(100)
  order_items   OrderItem[]

  @@map("menu_items")
}

model Order {
  id           Int         @id @default(autoincrement())
  customer_id  Int
  customer     Customer    @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  status       String      @default("active") @db.VarChar(20)
  total_amount Decimal     @default(0.0) @db.Decimal(10, 2)
  created_at   DateTime    @default(now()) @db.Timestamptz(6)
  updated_at   DateTime    @default(now()) @updatedAt @db.Timestamptz(6)
  items        OrderItem[]

  @@map("orders")
}

model OrderItem {
  id                  Int      @id @default(autoincrement())
  order_id            Int
  order               Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  menu_item_id        Int
  menu_item           MenuItem @relation(fields: [menu_item_id], references: [id])
  quantity            Int      @default(1)
  unit_price          Decimal  @db.Decimal(10, 2)
  customization_notes String?  @db.Text

  @@map("order_items")
}

model ConversationSummary {
  id          Int                         @id @default(autoincrement())
  customer_id Int
  customer    Customer                    @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  summary     String                      @db.Text
  embedding   Unsupported("vector(768)")?
  created_at  DateTime                    @default(now()) @db.Timestamptz(6)

  @@map("conversation_summaries")
}
